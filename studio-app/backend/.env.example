# BytePlus (same account as Boost app)
BYTEPLUS_API_KEY=your_byteplus_api_key_here
BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Models
BYTEPLUS_IMAGE_MODEL=seedream-4-5-251128
BYTEPLUS_3D_MODEL=hyper3d-rodin-20250412

# Tencent Cloud AI3D (Hunyuan3D) — https://console.tencentcloud.com/cam/capi
TENCENT_SECRET_ID=your_tencent_secret_id_here
TENCENT_SECRET_KEY=your_tencent_secret_key_here
TENCENT_AI3D_REGION=ap-guangzhou

# Database (studio_db on the shared VPS Postgres server, own schema — see CLAUDE.md)
DATABASE_URL=postgresql+asyncpg://studio:your_studio_db_password_here@127.0.0.1:5432/studio_db

# Redis (shared VPS instance — Nebula=DB0, Aura=DB1, Boost=DB2, Studio=DB3)
REDIS_URL=redis://127.0.0.1:6379/3

# Auth (JWT session cookies) — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your_random_jwt_secret_here

# Storage (local disk for now — see CLAUDE.md)
STORAGE_PATH=./storage
PUBLIC_BASE_URL=http://localhost:8006

# App
APP_NAME=Anom-AI-SaaS
PORT=8006
ENVIRONMENT=development

# CORS — update with Vercel URL after deploy
ALLOWED_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app
